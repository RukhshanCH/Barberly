# Get these from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings -> API -> service_role key.
# SERVER-SIDE ONLY. Never expose this to the browser or prefix it with
# NEXT_PUBLIC_. Used by the Stripe webhook route to update payment status
# with a request that has no logged-in user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (only needed if you set a deposit_amount > 0 on any service).
# Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_...
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
